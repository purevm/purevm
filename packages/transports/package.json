{
    "name": "@purevm/transports",
    "version": "0.1.0",
    "description": "Small JSON-RPC transports for HTTP and WebSocket.",
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "check": "pnpm lint && pnpm format:check",
        "check:fix": "pnpm format && pnpm lint:fix",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix --deny-warnings .",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "validate": "pnpm typecheck && pnpm check"
    },
    "devDependencies": {
        "@types/node": "^26.0.1",
        "tsdown": "^0.22.3",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
