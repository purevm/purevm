{
    "name": "@purevm/transports",
    "version": "0.1.0",
    "description": "Small JSON-RPC transports for HTTP and WebSocket.",
    "keywords": [
        "ethereum",
        "evm",
        "http",
        "json-rpc",
        "rpc",
        "transport",
        "typescript",
        "websocket"
    ],
    "homepage": "https://github.com/yog4a/purevm/tree/main/packages/transports#readme",
    "bugs": {
        "url": "https://github.com/yog4a/purevm/issues"
    },
    "license": "SEE LICENSE IN LICENSE.md",
    "author": "Yog4a",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yog4a/purevm.git",
        "directory": "packages/transports"
    },
    "files": [
        "dist",
        "LICENSE.md",
        "README.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsdown",
        "check": "pnpm lint && pnpm format:check && pnpm typecheck",
        "check:fix": "pnpm format && pnpm lint:fix",
        "dev": "tsdown --watch",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
        "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives .",
        "pack:check": "pnpm build && npm pack --dry-run --ignore-scripts",
        "prepack": "pnpm build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "validate": "pnpm check && pnpm test && pnpm build"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "^0.18.5",
        "@types/node": "^26.4.0",
        "@vitest/coverage-v8": "^4.1.11",
        "publint": "^0.3.24",
        "tsdown": "^0.22.14",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=22.18.0"
    }
}
