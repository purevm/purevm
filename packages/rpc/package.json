{
    "name": "@purevm/rpc",
    "version": "0.1.0",
    "description": "A fast, lightweight, dependency-free TypeScript toolkit for interacting with EVM-compatible blockchains over HTTP and WebSocket APIs.",
    "type": "module",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "test": "node --import tsx --test tests/*.test.ts",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^26.0.1",
        "dotenv": "^17.4.2",
        "tsdown": "^0.22.3",
        "tsx": "^4.22.4",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
