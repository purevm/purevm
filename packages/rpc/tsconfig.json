{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/types/*": ["./src/types/*"],
            "@/utils/*": ["./src/utils/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "modules/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
