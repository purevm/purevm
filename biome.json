{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": [
            "**",
            "!**/node_modules",
            "!**/dist",
            "!**/coverage",
            "!**/.cache",
            "!**/generated.ts",
            "!**/vectors/**/*.json",
            "!**/test/kzg/**/*.json",
            "!**/test/kzg/**/*.txt"
        ]
    },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 2,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "noBannedTypes": "off"
            },
            "correctness": {
                "noUnusedVariables": "error"
            },
            "performance": {
                "noBarrelFile": "off",
                "noReExportAll": "off",
                "noDelete": "off"
            },
            "style": {
                "noNonNullAssertion": "off",
                "useConsistentArrayType": {
                    "level": "error",
                    "options": {
                        "syntax": "shorthand"
                    }
                }
            },
            "suspicious": {
                "noAssignInExpressions": "off",
                "noConfusingVoidType": "off",
                "noExplicitAny": "off",
                "noConsole": "error",
                "noUnknownAtRules": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "trailingCommas": "all",
            "semicolons": "always"
        }
    },
    "json": {
        "formatter": {
            "indentStyle": "space",
            "indentWidth": 4
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
