{
  "name": "@yog4a/purevm",
  "description": "A fast, lightweight, dependency-free TypeScript toolkit for interacting with EVM blockchains.",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "test": "node --import tsx --test tests/*.test.ts",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "dep:check": "npx npm-check-updates",
    "dep:install": "npx npm-check-updates -u && npm install",
    "tags:update": "git push --follow-tags"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "dotenv": "^17.4.2",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  }
}
