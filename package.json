{
    "name": "purevm",
    "private": true,
    "description": "A fast, lightweight, dependency-free TypeScript toolkit for interacting with EVM blockchains.",
    "scripts": {
        "build": "pnpm -r --if-present build",
        "test": "pnpm -r --if-present test && pnpm test:new-heads && pnpm test:extensions",
        "test:extensions": "vitest run --config modules/extensions/vitest.config.mts",
        "test:extensions:coverage": "vitest run --config modules/extensions/vitest.config.mts --coverage",
        "test:new-heads": "vitest run --config modules/newHeads/vitest.config.mts",
        "test:new-heads:coverage": "vitest run --config modules/newHeads/vitest.config.mts --coverage",
        "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:new-heads && pnpm typecheck:extensions",
        "typecheck:extensions": "tsc --noEmit -p modules/extensions/tsconfig.json",
        "typecheck:new-heads": "tsc --noEmit -p modules/newHeads/tsconfig.json",
        "lint": "oxlint --deny-warnings --report-unused-disable-directives . && pnpm lint:variables",
        "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives .",
        "lint:variables": "node scripts/check-untyped-variables.mjs .",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "inspect:extensions:block": "tsx modules/extensions/scripts/inspect-block.ts",
        "inspect:extensions:debug": "tsx modules/extensions/scripts/inspect-debug-traces.ts",
        "inspect:extensions:parity": "tsx modules/extensions/scripts/inspect-parity-traces.ts",
        "inspect:extensions:range": "tsx modules/extensions/scripts/inspect-blocks-traces.ts",
        "inspect:extensions:receipts": "tsx modules/extensions/scripts/inspect-receipts.ts",
        "check": "pnpm lint && pnpm format:check",
        "check:fix": "pnpm format && pnpm lint:fix",
        "validate": "pnpm typecheck && pnpm check"
    },
    "dependencies": {
        "@purevm/rpc": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^26.4.0",
        "@vitest/coverage-v8": "^4.1.11",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "packageManager": "pnpm@10.34.5",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
