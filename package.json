{
    "name": "purevm",
    "private": true,
    "type": "module",
    "description": "A fast, lightweight, dependency-free TypeScript toolkit for interacting with EVM blockchains.",
    "scripts": {
        "build": "pnpm -r --if-present build",
        "test": "pnpm -r --if-present test",
        "typecheck": "pnpm -r --if-present typecheck",
        "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
        "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives .",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "check": "pnpm lint && pnpm format:check",
        "check:fix": "pnpm format && pnpm lint:fix",
        "validate": "pnpm typecheck && pnpm check"
    },
    "devDependencies": {
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0"
    },
    "packageManager": "pnpm@10.34.5",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
